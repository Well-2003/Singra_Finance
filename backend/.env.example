# Singra - variáveis do backend
#
# Em desenvolvimento: copie para backend/.env e preencha.
# No Render: cadastre cada uma em Environment > Environment Variables.
# Nenhum valor real entra no repositório.

# Assina os tokens de autenticação. Gere a sua com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SINGRA_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa

# Banco em nuvem (Aiven ou TiDB Cloud): a URL única que o painel entrega.
# Quando preenchida, ela tem prioridade sobre as variáveis soltas abaixo.
# SINGRA_DATABASE_URL=mysql://usuario:senha@host:porta/singra
# SINGRA_DB_SSL=1
# SINGRA_DB_SSL_CA=/etc/secrets/ca.pem

# Banco local, para desenvolvimento
SINGRA_DB_HOST=127.0.0.1
SINGRA_DB_PORT=3306
SINGRA_DB_USER=singra
SINGRA_DB_PASSWORD=
SINGRA_DB_NAME=singra

# Endereços autorizados a chamar a API, separados por vírgula.
# Em produção, o domínio do GitHub Pages:
#   https://seu-usuario.github.io
SINGRA_ORIGENS=http://localhost:5500,http://127.0.0.1:5500

# Validade do token de sessão, em horas
SINGRA_TOKEN_HORAS=720
