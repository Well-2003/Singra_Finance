# Singra - variáveis do backend
#
# Modelo do arquivo backend/.env, que fica fora do repositório. Nenhum valor
# real entra aqui.

# Assina os tokens de autenticação. Trocá-la derruba todas as sessões abertas.
SINGRA_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa

# URL única de conexão do banco em nuvem. Quando preenchida, tem prioridade
# sobre as variáveis soltas mais abaixo.
# SINGRA_DATABASE_URL=mysql://usuario:senha@host:porta/singra
# SINGRA_DB_SSL=1
# SINGRA_DB_SSL_CA=/etc/secrets/ca.pem

# Banco local, para desenvolvimento
SINGRA_DB_HOST=127.0.0.1
SINGRA_DB_PORT=3306
SINGRA_DB_USER=singra
SINGRA_DB_PASSWORD=
SINGRA_DB_NAME=singra

# Endereços autorizados a chamar a API, separados por vírgula. Um endereço
# que não estiver nesta lista é recusado pelo CORS.
SINGRA_ORIGENS=http://localhost:5500,http://127.0.0.1:5500

# Validade do token de sessão, em horas
SINGRA_TOKEN_HORAS=720
